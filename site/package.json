{
  "name": "dawg-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "demo": "bun scripts/record-demo.ts",
    "sync": "bun scripts/build-theme-bootstrap.ts",
    "dev": "bun run sync && next dev --webpack --hostname 127.0.0.1",
    "prebuild": "bun run sync",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test ./tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run sync && bun scripts/record-demo.ts --check && bun run test && bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.41.3",
    "@hraness/posthog": "https://github.com/hraness/posthog/releases/download/v0.3.12/hraness-posthog-0.3.12.tgz",
    "@hraness/site-footer": "https://github.com/hraness/site-footer/releases/download/v0.20.9/hraness-site-footer-0.20.9.tgz",
    "@hraness/ui": "github:hraness/ui#v0.5.25",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.13.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "fast-glob": "npm:tinyglobby@0.2.17"
  }
}
