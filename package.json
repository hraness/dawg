{
  "name": "@hraness/track",
  "version": "0.2.0",
  "license": "MIT",
  "repository": "https://github.com/hraness/track",
  "description": "A local-first terminal music workstation with an agent-driven piano-roll interface.",
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/fixtures/**",
    "core/**/*.ts",
    "!core/**/*.test.ts",
    "tui/**/*.ts",
    "!tui/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "bin": {
    "track": "./src/main.ts"
  },
  "scripts": {
    "track": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck && bun run format",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "bun-types": "1.3.14",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
