{
  "name": "@hraness/dawg",
  "version": "0.38.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/dawg.git"
  },
  "homepage": "https://dawg.sh",
  "bugs": "https://github.com/hraness/dawg/issues",
  "description": "Generate songs with an agent, watch them take shape, and listen live in your terminal.",
  "type": "module",
  "files": [
    "src/**/*.ts",
    "src/vocals/python/*.py",
    "src/vocals/python/requirements.txt",
    "src/vocals/python/README.md",
    "src/reference/python/*.py",
    "src/reference/python/requirements.txt",
    "src/reference/python/README.md",
    "workflows/**",
    "!src/**/*.test.ts",
    "!src/**/fixtures/**",
    "!src/**/*-fixtures.ts",
    "core/**/*.ts",
    "!core/**/*.test.ts",
    "core/sdk/**",
    "tui/**/*.ts",
    "!tui/**/*.test.ts",
    "guides/*.md",
    "assets/samples/**",
    "guides/index.ts",
    "guides/marks.ts",
    "docs/agent/recipes/*.md",
    "docs/song-studio.md",
    "CHANGELOG.md",
    "DAWG.md",
    "native/prebuilt/manifest.json",
    "native/prebuilt/*/libdawg_sink.*"
  ],
  "bin": {
    "dawg": "./src/main.ts"
  },
  "scripts": {
    "dawg": "bun run src/main.ts",
    "bench:perf": "bun bench/perf/run.ts",
    "sizes": "bun bench/sizes/matrix.ts",
    "test": "bun test",
    "screens": "bun test/screens/capture.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun test && bun run typecheck && bun run format",
    "format": "prettier --check ."
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "bun-types": "1.4.4",
    "prettier": "3.9.10"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
