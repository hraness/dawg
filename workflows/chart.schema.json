{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dawg:chart:v1",
  "title": "DAWG authored chart",
  "description": "A portable structural guide. Runtime checkChart and the shared house policy additionally validate musical meaning.",
  "type": "object",
  "required": ["title", "key", "mode", "bpm", "sounds", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "key": {
      "enum": ["C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"]
    },
    "mode": { "const": "major" },
    "bpm": { "type": "number", "minimum": 100, "maximum": 180 },
    "sounds": {
      "type": "object",
      "required": [
        "pad",
        "stab",
        "arp",
        "arp2",
        "lead",
        "counter",
        "bass",
        "singer",
        "kit",
        "design"
      ],
      "properties": {
        "pad": { "$ref": "#/$defs/sound" },
        "stab": { "$ref": "#/$defs/sound" },
        "arp": { "$ref": "#/$defs/sound" },
        "arp2": { "$ref": "#/$defs/sound" },
        "lead": { "$ref": "#/$defs/sound" },
        "counter": { "$ref": "#/$defs/sound" },
        "bass": { "$ref": "#/$defs/sound" },
        "singer": { "$ref": "#/$defs/sound" },
        "kit": {
          "type": "object",
          "required": ["kick", "snare", "hats"],
          "properties": {
            "kick": { "$ref": "#/$defs/sound" },
            "snare": { "$ref": "#/$defs/sound" },
            "hats": { "$ref": "#/$defs/sound" }
          },
          "additionalProperties": false
        },
        "design": {
          "type": "object",
          "required": ["brightness", "grit", "space", "width", "echo"],
          "properties": {
            "brightness": { "$ref": "#/$defs/unit" },
            "grit": { "$ref": "#/$defs/unit" },
            "space": { "$ref": "#/$defs/unit" },
            "width": { "$ref": "#/$defs/unit" },
            "echo": { "$ref": "#/$defs/unit" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/section" }
    },
    "notes": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 500 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sound": { "type": "string", "minLength": 1, "maxLength": 64 },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "lines": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["bar", "rhythm", "notes"],
        "properties": {
          "bar": { "type": "number", "minimum": 0, "maximum": 8 },
          "rhythm": { "type": "string", "maxLength": 80 },
          "notes": { "type": "string", "maxLength": 512 },
          "words": { "type": "string", "maxLength": 512 }
        },
        "additionalProperties": false
      }
    },
    "grids": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[0-9.\\-]{16}$" }
    },
    "section": {
      "type": "object",
      "required": ["kind", "name", "bars", "chords", "drums", "play"],
      "properties": {
        "kind": {
          "enum": [
            "intro",
            "verse",
            "pre",
            "chorus",
            "drop",
            "break",
            "bridge",
            "outro"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bars": { "type": "integer", "minimum": 1, "maximum": 8 },
        "chords": { "type": "string", "maxLength": 160 },
        "drums": { "type": "string", "maxLength": 32 },
        "drums2": { "type": "string", "maxLength": 32 },
        "energy": { "$ref": "#/$defs/unit" },
        "play": {
          "type": "array",
          "maxItems": 14,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pad",
              "keys",
              "stabs",
              "arp",
              "arp2",
              "lead",
              "counter",
              "chops",
              "harmony",
              "double",
              "vocoder",
              "cloud",
              "spark",
              "sub"
            ]
          }
        },
        "sing": { "$ref": "#/$defs/lines" },
        "hook": { "$ref": "#/$defs/lines" },
        "counter": { "$ref": "#/$defs/lines" },
        "chops": { "$ref": "#/$defs/lines" },
        "stabs": { "$ref": "#/$defs/grids" },
        "kick": { "$ref": "#/$defs/grids" },
        "snare": { "$ref": "#/$defs/grids" },
        "hats": { "$ref": "#/$defs/grids" },
        "arp": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[0-4]{8}$" }
        },
        "bass": { "enum": ["lock", "hold", "offbeat", "rolling", "walk"] },
        "moves": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["move"],
            "properties": {
              "move": {
                "enum": [
                  "stutter",
                  "dropout",
                  "silence",
                  "landing",
                  "tapeStop",
                  "riser",
                  "drift",
                  "crush",
                  "dive"
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
